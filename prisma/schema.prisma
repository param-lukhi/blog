generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id            String     @id @default(cuid())
  name          String     @unique
  slug          String     @unique
  description   String?
  icon          String?
  image         String?
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]
  blogs         Blog[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Product {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  brand          String
  price          String
  images         String       // JSON string of image URLs
  amazonUrl      String
  affiliateUrl   String
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  specifications String       // JSON string of key-value specs
  features       String       // JSON string of feature bullet points
  pros           String       // JSON string of pros list
  cons           String       // JSON string of cons list
  marketplaces   String?      // JSON string of regional prices & affiliate links
  isFeatured     Boolean      @default(false)
  isTrending     Boolean      @default(false)
  isDeal         Boolean      @default(false)
  status         String       @default("PUBLISHED") // DRAFT, PUBLISHED, HIDDEN, ARCHIVED
  blogs          Blog[]
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  metaTitle       String?
  metaDescription String?
  featuredImage   String
  content         String    // Rich HTML / Markdown content
  specifications  String?   // JSON string
  features        String?   // JSON string
  pros            String?   // JSON string
  cons            String?   // JSON string
  faqs            String?   // JSON string of [{question, answer}]
  conclusion      String?
  amazonUrl       String
  affiliateUrl    String?
  marketplaces    String?   // JSON string of regional prices & affiliate links
  status          String    @default("PUBLISHED") // DRAFT, PUBLISHED, HIDDEN, SCHEDULED
  scheduledAt     DateTime?
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  tags            String    // JSON string or comma-separated
  views           Int       @default(0)
  comments        Comment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN") // ADMIN, EDITOR, AUTHOR
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  author    String
  email     String
  content   String
  status    String   @default("PENDING") // PENDING, APPROVED, SPAM
  blogId    String?
  blog      Blog?    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("SUBSCRIBED") // SUBSCRIBED, UNSUBSCRIBED
  createdAt DateTime @default(now())
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deal {
  id            String   @id @default(cuid())
  title         String
  discount      String
  originalPrice String
  dealPrice     String
  dealUrl       String
  badge         String?  // Hot, Limited, Exclusive
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  expiresAt     DateTime?
  status        String   @default("PUBLISHED") // PUBLISHED, DRAFT, EXPIRED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Comparison {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  summary    String?
  product1Id String
  product2Id String
  winnerId   String?
  status     String   @default("PUBLISHED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AffiliateLink {
  id          String   @id @default(cuid())
  title       String
  originalUrl String
  cloakedUrl  String   @unique
  category    String?
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Advertisement {
  id        String   @id @default(cuid())
  title     String
  location  String   // HEADER, SIDEBAR, IN_ARTICLE, FOOTER
  image     String
  targetUrl String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Analytics {
  id         String   @id @default(cuid())
  eventType  String   // PAGE_VIEW, AFFILIATE_CLICK, PRODUCT_VIEW, SEARCH
  targetId   String?
  targetType String?  // BLOG, PRODUCT, CATEGORY
  path       String?
  referrer   String?
  keyword    String?
  userAgent  String?
  ipHash     String?
  createdAt  DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
}
