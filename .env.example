# Database Configuration (Neon PostgreSQL Database)
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Admin Authentication Cryptographic Secret & Initial Admin Setup
ADMIN_SESSION_SECRET="generate_a_random_32_character_secret_key_here"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your-strong-admin-password"

# Site Metadata & Domain Configuration
NEXT_PUBLIC_SITE_URL="https://blogweb904.vercel.app"

# Amazon & Affiliate Program Configuration
NEXT_PUBLIC_DEFAULT_MARKETPLACE="amazon.com"
NEXT_PUBLIC_DEFAULT_AFFILIATE_TAG="yourtag-20"

# Cloud Media Storage (Optional / Required for Serverless Vercel Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_UPLOAD_PRESET="your_upload_preset"
